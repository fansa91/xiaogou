<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="12dp">
    <TextView
        android:id="@+id/widget_today_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="今日"
        android:textSize="16sp" />
    <TextView
        android:id="@+id/widget_today_expense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="支出 0.00"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/widget_today_income"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="收入 0.00"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/widget_today_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="结余 0.00"
        android:textSize="14sp" />
</LinearLayout>
